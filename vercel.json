{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["**/*.py"]
      }
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api", "dest": "api/index.py" },
    { "src": "/", "dest": "web/index.html" },
    { "src": "/app.js", "dest": "web/app.js" },
    { "src": "/styles.css", "dest": "web/styles.css" }
  ]
}
